# VoltSpot Environment Variables
# NEVER commit real production keys or service-role keys!

# Supabase Public Configuration (Leave blank or set to local demo mode)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Mapbox/Tile Provider Key (VoltSpot uses OpenStreetMap/Leaflet without requiring any API key)
VITE_MAP_PROVIDER_KEY=
